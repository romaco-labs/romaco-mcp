# ── romaco MCP — config ──────────────────────────────────────────────────────

# WebSocket bridge port (live chart). Default 7399.
# ROMACO_MCP_PORT=7399

# Browser bridge auth. Default auto: valid token -> paired v2; absent -> legacy
# warning; malformed configured token -> chart bridge disabled.
# ROMACO_MCP_BRIDGE_AUTH=auto
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# ROMACO_MCP_BRIDGE_TOKEN=

# Extra exact HTTP(S) origins. Wildcards are not accepted.
# ROMACO_MCP_ALLOWED_ORIGINS=https://charts.example.com

# OHLCV candle cache directory. Default ~/.romaco/cache
# ROMACO_CACHE_DIR=

# ── Reserved remote adapter ──────────────────────────────────────────────────
# Current analysis is local. These values DO NOT authorize or trigger candle
# egress. They are reserved for a future explicit remote-adapter contract.
ROMACO_TOKEN=
# ROMACO_API_URL=

# Optional redacted local tool telemetry. Disabled unless value is exactly
# "jsonl". Writes JSONL to stderr only; never sends telemetry over network.
# ROMACO_MCP_TELEMETRY=jsonl

# ── Auto-open browser ─────────────────────────────────────────────────────────
# When set, romaco_setup_chart opens this URL automatically if no McpBridge is
# connected yet — gives you the chart tab without leaving the terminal.
# Local dev: ROMACO_APP_URL=http://localhost:5173
# Hosted:    ROMACO_APP_URL=https://www.romaco.io/dashboard
# ROMACO_APP_URL=
